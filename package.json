{
    "name": "dior-agent",
    "version": "0.1.0",
    "private": true,
    "description": "Private WebSocket agent service powered by Bun",
    "type": "module",
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "dev": "bun run src/entrypoints/server.ts",
        "dev:watch": "bun --watch src/entrypoints/server.ts",
        "start": "bun run dist/server-bun.js",
        "build": "bun run build.ts",
        "build:vite": "vite build",
        "build:vite:only": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "check": "biome check .",
        "test": "bun test",
        "page:dev": "bun run --cwd page dev",
        "page:build": "bun run --cwd page build",
        "page:typecheck": "bun run --cwd page typecheck",
        "test:all": "bun run typecheck && bun run check && bun test && bun run build && bun run build:vite && bun run page:build"
    },
    "dependencies": {
        "@hono/node-server": "^2.0.4",
        "hono": "^4.12.23",
        "ws": "^8.21.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@types/bun": "^1.2.0",
        "@types/node": "^25.9.1",
        "@types/ws": "^8.18.1",
        "bun": "^1.3.14",
        "typescript": "^5.7.0",
        "vite": "^6.0.0"
    }
}
